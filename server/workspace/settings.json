{
  "editor": {
    "fontSize": 14,
    "tabSize": 2,
    "wordWrap": "off",
    "lineNumbers": true,
    "highlightActiveLine": true,
    "autoSave": "off",
    "autoSaveDelay": 1000,
    "colorTheme": "dark-plus",
    "insertSpaces": true
  },
  "files": {
    "exclude": [
      "node_modules",
      ".git",
      "dist",
      "build",
      ".cache",
      ".next",
      "vendor",
      "target",
      "coverage",
      ".gradle",
      ".idea",
      ".dart_tool",
      "Pods"
    ]
  },
  "search": {
    "exclude": [
      "node_modules",
      ".git",
      "dist",
      "build",
      ".cache",
      ".next",
      "vendor",
      "target",
      "coverage",
      ".gradle",
      ".idea",
      ".dart_tool",
      "Pods"
    ],
    "maxResults": 1000
  },
  "terminal": {
    "fontSize": 13,
    "prompt": "\\u@\\h \\w \\$ "
  },
  "workbench": {
    "sidebarWidth": 240,
    "iconTheme": "ext:PKief.material-icon-theme:./dist/material-icons.json"
  },
  "textTools": {
    "greeting": "Hello from settings.json"
  }
}
