{
  "name": "text-tools",
  "displayName": "Text Tools",
  "publisher": "kode",
  "version": "0.1.0",
  "description": "Demo extension using the document model, text edits, workspace edits and events.",
  "main": "./extension.js",
  "engines": { "vscode": "^1.80.0" },
  "activationEvents": [
    "onCommand:textTools.stats",
    "onCommand:textTools.upperSelection",
    "onCommand:textTools.insertTimestamp",
    "onCommand:textTools.appendLine"
  ],
  "contributes": {
    "commands": [
      { "command": "textTools.stats", "title": "Text Tools: Show Document Stats" },
      { "command": "textTools.upperSelection", "title": "Text Tools: Uppercase Selection" },
      { "command": "textTools.insertTimestamp", "title": "Text Tools: Insert Timestamp" },
      { "command": "textTools.appendLine", "title": "Text Tools: Append Line (WorkspaceEdit)" }
    ]
  }
}
